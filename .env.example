# Copy this file to .env and fill in your real values.
# .env is ignored by git. This file is safe to share: placeholders only.
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional (defaults shown). Checked at startup by src/helpdesk/core/settings.py.
# GEMINI_TIMEOUT_SECONDS=60
# GEMINI_RETRY_ATTEMPTS=5
# LOG_FORMAT=json   # one JSON object per log line (servers); default: readable lines for a terminal
# COOKIE_SECURE=false   # only for local development over plain http in Safari; never in production
# DATABASE_URL=postgresql://helpdesk:local-only@127.0.0.1:5433/helpdesk   # the default: Postgres from compose.yaml
# DEMO_MODE=true   # the one-click staff demo with sample tickets (the public demo site)
# CLIENT_IP_HEADER=CF-Connecting-IP   # only behind a proxy that sets it (Render); default: none trusted
# DAILY_TICKET_CAP=300   # tickets per day for the whole system (cost ceiling)
