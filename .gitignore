# Secrets: holds the API key, never upload
.env

# Virtual environment: each computer creates its own
.venv/

# Python cache: compiled files Python creates automatically
__pycache__/

# macOS: hidden folder-settings files Finder creates
.DS_Store

# Claude Code: personal local settings (permissions on this Mac)
.claude/settings.local.json

# Generated bundle of the whole project (rebuild with tools/make_context.py)
claude_context.md
